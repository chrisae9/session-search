[Unit]
Description=Synchronize Session Search device credentials

[Service]
Type=oneshot
EnvironmentFile=%h/.config/session-search-v1/credentials-sync.env
ExecStart=%h/.local/bin/session-search sync-credentials --registry ${SESSION_SEARCH_CREDENTIALS} --host ${SESSION_SEARCH_CREDENTIAL_HOST} --remote-registry ${SESSION_SEARCH_REMOTE_CREDENTIALS} --remote-executable ${SESSION_SEARCH_REMOTE_EXECUTABLE} --receipt ${SESSION_SEARCH_CREDENTIAL_RECEIPT}
UMask=0077
TimeoutStartSec=60
