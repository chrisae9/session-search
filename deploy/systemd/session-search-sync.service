[Unit]
Description=Bounded Session Search client capture and upload

[Service]
Type=oneshot
EnvironmentFile=%h/.config/session-search-v1/sync.env
ExecStart=%h/.local/bin/session-search --data-dir ${SESSION_SEARCH_DATA} --primary ${SESSION_SEARCH_PRIMARY} --token-file ${SESSION_SEARCH_TOKEN_FILE} sync --codex-home ${SESSION_SEARCH_CODEX_HOME} --producer ${SESSION_SEARCH_PRODUCER} --max-bytes ${SESSION_SEARCH_CAPTURE_BYTES} --max-pending-bytes ${SESSION_SEARCH_BACKLOG_BYTES} --reserve-bytes ${SESSION_SEARCH_RESERVE_BYTES} --archive-raw --chunk-raw
Nice=10
UMask=0077
